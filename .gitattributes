# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Source code
*.cs       text diff=csharp
*.csproj   text
*.sln      text eol=crlf
*.props    text
*.targets  text
*.json     text
*.yml      text
*.yaml     text
*.md       text
*.editorconfig text

# Binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.snk   binary
*.dll   binary
*.exe   binary

# Verify snapshot files
*.verified.txt -text
